{
  "name": "cards-clash",
  "private": true,
  "version": "0.1.0",
  "description": "Cards Clash - an original lane-based collectible card game built with Phaser 3 + TypeScript.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim:ai": "vite-node scripts/ai-benchmark.ts",
    "sim:decks": "vite-node scripts/deck-matrix.ts",
    "package:web": "node scripts/package-web.mjs",
    "assets:app": "python scripts/make_app_assets.py && capacitor-assets generate --android --iconBackgroundColor #120c2b --splashBackgroundColor #120c2b",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "node scripts/android.mjs apk",
    "android:aab": "node scripts/android.mjs aab",
    "android:open": "cap open android",
    "server:build": "vite build --config vite.server.config.ts",
    "server:start": "supabase start --workdir server",
    "server:stop": "supabase stop --workdir server",
    "server:serve": "npm run server:build && supabase functions serve game --workdir server",
    "server:e2e": "vite-node scripts/online-e2e.ts",
    "server:deploy": "npm run server:build && supabase db push --workdir server && supabase functions deploy game --workdir server"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
