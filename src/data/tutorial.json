      "name": "Lanes and Creatures",
      "summary": "Play creatures, end your turn, and hit the enemy Hero.",
      "reward": {
        "coins": 100,
        "xp": 40
      },
      "player": {
        "name": "You",
        "heroId": "finn",
        "landscapes": [
          "golden",
          "golden",
          "golden",
          "golden"
        ],
        "cards": [
          "travelin_farmer",
          "cornball",
          "husker_knight",
          "corn_dog",
          "rural_earl",
          "archer_dan",
          "cornball",
          "travelin_farmer",
          "corn_dog",
          "husker_worm",
          "rural_earl",
          "archer_dan",
          "husker_knight",
          "corn_dog",
          "travelin_farmer",
          "husker_worm",
          "rural_earl",
          "cornball"
        ]
      },
      "enemy": {
        "name": "Training Dummy",
        "heroId": "banana_guard",
        "landscapes": [
          "dune",
          "dune",
          "dune",
          "dune"
        ],
        "cards": [
          "sand_eyebat",
          "green_cactaball",
          "burning_hand",
          "sand_angel",
          "sand_eyebat",
          "green_cactaball",
          "burning_hand",
          "sand_angel",
          "sand_eyebat",
          "green_cactaball",
          "burning_hand",
          "sand_angel",
          "sand_eyebat",
          "green_cactaball",
          "burning_hand",
          "sand_angel"
        ]
      },
      "enemyRules": [
        "training_dummy"
      ],
      "playerRules": [],
      "enemyScript": [
        [
          {
            "type": "playCard",
            "card": "sand_eyebat",
            "lane": 3
          }
        ],
        [
          {
            "type": "playCard",
            "card": "green_cactaball",
            "lane": 1
          }
        ]
      ],
      "steps": [
        {
          "text": "Welcome to Cards Clash! The board has 4 lanes. Your creatures sit in the bottom row and fight whatever is straight across from them.",
          "highlight": [
            {
              "kind": "lane",
              "side": "me",
              "lane": 1
            },
            {
              "kind": "lane",
              "side": "enemy",
              "lane": 1
            }
          ]
        },
        {
          "text": "Cards cost MP (magic points), shown in the top-left corner of each card. You have 2 MP on your first turn and 1 more every turn after, up to 8.",
          "highlight": [
            {
              "kind": "hero",
              "side": "me"
            }
          ]
        },
        {
          "text": "Drag the Travelin' Farmer into lane 2 (or tap it, then tap the lane).",
          "highlight": [
            {
              "kind": "hand",
              "card": "travelin_farmer"
            },
            {
              "kind": "lane",
              "side": "me",
              "lane": 1
            }
          ],
          "expect": {
            "type": "playCard",
            "card": "travelin_farmer",
            "lane": 1
          }
        },
        {
          "text": "Creatures can't attack on the turn they are played. When you end your turn, all your ready creatures attack.",
          "highlight": [
            {
              "kind": "creature",
              "side": "me",
              "lane": 1
            }
          ]
        },
        {
          "text": "Tap End Turn to pass to your opponent.",
          "highlight": [
            {
              "kind": "endTurn"
            }
          ],
          "expect": {
            "type": "endTurn"
          }
        },
        {
          "text": "The enemy put a Green Cactaball in front of your Farmer, so it will fight that instead of the Hero.",
          "highlight": [
            {
              "kind": "creature",
              "side": "me",
              "lane": 1
            },
            {
              "kind": "creature",
              "side": "enemy",
              "lane": 1
            }
          ]
        },
        {
          "text": "A Sand Eyebat sits in lane 4 with nothing across from it. Play the Corn Dog there to block it: it costs 2 MP.",
          "highlight": [
            {
              "kind": "hand",
              "card": "corn_dog"
            },
            {
              "kind": "lane",
              "side": "me",
              "lane": 3
            }
          ],
          "expect": {
            "type": "playCard",
            "card": "corn_dog",
            "lane": 3
          }
        },
        {
          "text": "End your turn and watch your creatures attack.",
          "highlight": [
            {
              "kind": "endTurn"
            }
          ],
          "expect": {
            "type": "endTurn"
          }
        },
        {
          "text": "Attacking creatures deal damage equal to their ATK (left number). A creature is destroyed when its damage reaches its DEF (right number).",
          "highlight": [
            {
              "kind": "creature",
              "side": "me",
              "lane": 3
            }
          ]
        },
        {
          "text": "A creature with nothing across from it hits the enemy Hero directly. Keep playing creatures and ending your turn until the Training Dummy hits 0 HP. Good luck!",
          "highlight": [
            {
              "kind": "hero",
              "side": "enemy"
            }
          ]
        }
      ]
    },
