      ],
      "playerRules": [],
      "enemyScript": [
        [
          {
            "type": "playCard",
            "card": "husker_worm",
            "lane": 1
          }
        ],
        [
          {
            "type": "playCard",
            "card": "patchy_the_pumpkin",
            "lane": 0
          }
        ]
      ],
      "steps": [
        {
          "text": "This lesson covers Floop abilities, buildings and spells. Start by playing the Bog Bum in lane 2.",
          "highlight": [
            {
              "kind": "hand",
              "card": "bog_bum"
            },
            {
              "kind": "lane",
              "side": "me",
              "lane": 1
            }
          ],
          "expect": {
            "type": "playCard",
            "card": "bog_bum",
            "lane": 1
          }
        },
        {
          "text": "End your turn.",
          "highlight": [
            {
              "kind": "endTurn"
            }
          ],
          "expect": {
            "type": "endTurn"
          }
        },
        {
          "text": "A Husker Worm (3/5) is blocking your Bog Bum. Every creature has a Floop ability: pay its cost and the creature uses its power instead of attacking this turn.",
          "highlight": [
            {
              "kind": "creature",
              "side": "enemy",
              "lane": 1
            }
          ]
        },
        {
          "text": "Tap your Bog Bum and choose Floop: it deals 5 damage to the creature across from it.",
          "highlight": [
            {
              "kind": "creature",
              "side": "me",
              "lane": 1
            }
          ],
          "expect": {
            "type": "floop",
            "lane": 1
          }
        },
        {
          "text": "Buildings sit behind your creatures and boost whoever is in their lane. Put the Corn Dome in lane 2 for +3 ATK.",
          "highlight": [
            {
              "kind": "hand",
              "card": "corn_dome"
            },
            {
              "kind": "lane",
              "side": "me",
              "lane": 1
            }
          ],
          "expect": {
            "type": "playCard",
            "card": "corn_dome",
            "lane": 1
          }
        },
        {
          "text": "Your Bog Bum is exhausted from flooping, so it won't attack this turn. End your turn.",
          "highlight": [
            {
              "kind": "endTurn"
            }
          ],
          "expect": {
            "type": "endTurn"
          }
        },
        {
          "text": "Uh oh, Patchy the Pumpkin hits for 22! Spells happen right away and then go to the discard pile. Cast Cerebral Bloodstorm on it: it deals damage equal to its own ATK.",
          "highlight": [
            {
              "kind": "hand",
              "card": "cerebral_bloodstorm"
            },
            {
              "kind": "creature",
              "side": "enemy",
              "lane": 0
            }
          ],
          "expect": {
            "type": "playCard",
            "card": "cerebral_bloodstorm",
            "target": {
              "kind": "creature",
              "side": "enemy",
              "lane": 0
            }
          }
        },
        {
          "text": "Teeth Leaf can Floop to hit the enemy Hero directly. Play it in lane 3.",
          "highlight": [
            {
              "kind": "hand",
              "card": "teeth_leaf"
            },
            {
              "kind": "lane",
              "side": "me",
              "lane": 2
            }
          ],
          "expect": {
            "type": "playCard",
            "card": "teeth_leaf",
            "lane": 2
          }
        },
        {
          "text": "Long-press any card or creature to read it in detail. Now use everything you have learned to defeat the Practice Squire!",
          "highlight": [
            {
              "kind": "hero",
              "side": "enemy"
            }
          ]
        }
      ]
    },
